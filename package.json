{
  "name": "container-cove",
  "version": "1.2.1",
  "description": "Run containers as desktop apps",
  "license": "MIT",
  "scripts": {
    "start": "bunx electrobun dev",
    "build": "bunx electrobun build",
    "build:mac": "bunx electrobun build --platform darwin",
    "build:win": "bunx electrobun build --platform win32",
    "build:linux": "bunx electrobun build --platform linux",
    "build:dmg": "bun scripts/build-macos-dmg.ts",
    "build:pkg": "bun scripts/build-macos-pkg.ts",
    "build:installer": "bun scripts/build-installer.ts",
    "build:win-installer": "bun scripts/build-windows-installer.ts",
    "build:linux-appimage": "bun scripts/build-linux-appimage.ts",
    "build:linux-deb": "bun scripts/build-linux-deb.ts",
    "postinstall": "node scripts/patch-electrobun-rpc.mjs",
    "test": "bun test",
    "lint": "eslint \"src/**/*.ts\" \"electrobun.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"*.{json,md,ts}\"",
    "typecheck": "bunx tsc -p tsconfig.check.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs"
  },
  "dependencies": {
    "electrobun": "1.18.1",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4"
  }
}
